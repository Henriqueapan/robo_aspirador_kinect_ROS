<?xml version="1.0"?>
<!--
  Cobertura de área (adaptado de robo_aspirador_ROS-original).

  Estrutura idêntica ao original: move_base_flex + full_coverage_path_planner
  (SpiralSTC) + tracking_pid (interpolator + controller) + map_server +
  coverage_progress + goal + rviz.

  Diferenças (P3DX -> Kobuki/Kinect):
    - odom:    /p3dx/odom          -> /odom
    - scan:    /p3dx/laser/scan    -> /scan
    - cmd_vel: /p3dx/cmd_vel       -> /cmd_vel_mux/input/navi (input do mux Kobuki)
    - robot_radius/tool_radius ajustados ao Kobuki (~0.18 m de raio), com
      robot_radius SEMPRE >= tool_radius (ver comentário nos args)
-->
<launch>
  <!-- Silencia o flood de TF_REPEATED_DATA (ruído do plugin Kobuki no Gazebo) -->
  <env name="ROSCONSOLE_CONFIG_FILE" value="$(find robo_aspirador_kinect)/config/rosconsole.conf"/>

  <!-- Parâmetros do mapa (usar o *_fechado: desconhecido pintado como parede,
       senão a cobertura vaza pelas fronteiras não mapeadas) -->
  <arg name="map" default="$(find robo_aspirador_kinect)/maps/mapa_atual_fechado.yaml"/>
  <arg name="coverage_area_offset" default="-2.5 -2.5 0 0 0 0"/>
  <arg name="coverage_area_size_x" default="10"/>
  <arg name="coverage_area_size_y" default="10"/>

  <!-- Tópicos do robô (Kobuki/Kinect) -->
  <arg name="odom_topic" default="/odom"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="cmd_vel_topic" default="/cmd_vel_mux/input/navi"/>

  <!-- Parâmetros do Tracking PID -->
  <arg name="target_x_vel" default="0.5"/>
  <arg name="target_yaw_vel" default="0.4"/>

  <!-- Geometria do robô (Kobuki). robot_radius deve ser >= tool_radius:
       no parseGrid do full_coverage_path_planner os raios viram pixels uint32;
       tool > robot causa underflow em robotNodeSize-nodeSize e o planejador
       passa a enxergar o mapa inteiro como livre (paths através de paredes). -->
  <arg name="robot_radius" default="0.2"/>
  <arg name="tool_radius" default="0.18"/>

  <arg name="rviz" default="true"/>

  <!-- Move base flex usando full_coverage_path_planner -->
  <node pkg="mbf_costmap_nav" type="mbf_costmap_nav" respawn="false" name="move_base_flex" output="log" required="true">
    <param name="tf_timeout" value="1.5"/>
    <rosparam file="$(find full_coverage_path_planner)/test/full_coverage_path_planner/param/planners.yaml" command="load" />
    <rosparam file="$(find full_coverage_path_planner)/test/full_coverage_path_planner/param/local_costmap_params.yaml" command="load" />
    <param name="SpiralSTC/robot_radius" value="$(arg robot_radius)"/>
    <param name="SpiralSTC/tool_radius" value="$(arg tool_radius)"/>
    <param name="global_costmap/robot_radius" value="$(arg robot_radius)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    <remap from="scan" to="$(arg scan_topic)"/>

    <remap from="/move_base_flex/SpiralSTC/plan" to="/move_base/SpiralSTC/plan"/>
    <remap from="/move_base_flex/tracking_pid/interpolator" to="/move_base/TrackingPidLocalPlanner/interpolator"/>
  </node>

  <!-- Compatibilidade retroativa do Move Base -->
  <node pkg="mbf_costmap_nav" type="move_base_legacy_relay.py" name="move_base" output="log">
    <param name="base_global_planner" value="SpiralSTC" />
  </node>

  <node name="grid_server" pkg="map_server" type="map_server" args="$(arg map)" output="log">
    <param name="frame_id" value="map"/>
  </node>

  <!-- O tracking_pid não pode aceitar apenas um nav_msgs/Path, ele só pode ir para um PoseStamped,
       então o path_interpolator arrasta um PoseStamped sobre um Path a uma velocidade dada -->
  <node name="interpolator" pkg="tracking_pid" type="path_interpolator" output="log">
    <param name="target_x_vel" value="$(arg target_x_vel)"/>
    <param name="target_yaw_vel" value="$(arg target_yaw_vel)"/>
    <remap from="path" to="/move_base/SpiralSTC/plan"/>
  </node>

  <!-- O tracking_pid tenta aproximar o robô o máximo possível do ponto de destino -->
  <node name="controller" pkg="tracking_pid" type="controller" output="log">
    <remap from="move_base/cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="local_trajectory" to="trajectory"/>
    <param name="controller_debug_enabled" value="True"/>
    <param name="track_base_link" value="true"/>
    <param name="l" value="0.5"/>
    <param name="Ki_long" value="0.0"/>
    <param name="Kp_long" value="2.0"/>
    <param name="Kd_long" value="0.5"/>
    <param name="Ki_lat" value="0.0"/>
    <param name="Kp_lat" value="4.0"/>
    <param name="Kd_lat" value="0.3"/>
  </node>

  <!-- Inicia o rastreamento de progresso de cobertura -->
  <node pkg="tf" type="static_transform_publisher" name="map_to_coveragemap" args="$(arg coverage_area_offset) map coverage_map 100" output="log" />
  <node pkg="full_coverage_path_planner" type="coverage_progress" name="coverage_progress" output="log">
    <param name="~target_area/x" value="$(arg coverage_area_size_x)" />
    <param name="~target_area/y" value="$(arg coverage_area_size_y)" />
    <param name="~coverage_radius" value="$(arg tool_radius)" />
    <remap from="reset" to="coverage_progress/reset" />
    <param name="~map_frame" value="coverage_map"/>
  </node>

  <!-- Dispara o planejador publicando um objetivo do move_base -->
  <node name="publish_simple_goal" pkg="rostopic" type="rostopic" output="log" launch-prefix="bash -c 'sleep 1.0; $0 $@' "
        args="pub --latch /move_base/goal move_base_msgs/MoveBaseActionGoal --file=$(find full_coverage_path_planner)/test/simple_goal.yaml"/>

  <!-- rviz -->
  <node if="$(eval rviz)" name="rviz" pkg="rviz" type="rviz" args="-d $(find full_coverage_path_planner)/test/full_coverage_path_planner/fcpp.rviz" output="log" />
</launch>
