<!--
  Simulação: TurtleBot2 (Kobuki) + Kinect v1 (Xbox 360) em Gazebo.

  O sensor RGB-D NÃO usa libfreenect/OpenNI nesta POC: o plugin Gazebo do URDF
  kinect publica Image / CameraInfo / PointCloud2 nos mesmos tópicos que o driver
  real (freenect_stack) publicaria — ver README e config/rgbd_topics.yaml.
-->
<launch>
  <!-- Silencia o flood de TF_REPEATED_DATA (ruído do plugin Kobuki no Gazebo) -->
  <env name="ROSCONSOLE_CONFIG_FILE" value="$(find robo_aspirador_kinect)/config/rosconsole.conf"/>

  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>

  <!-- kobuki + stacks hexagons + kinect (URDF: kobuki_hexagons_kinect.urdf.xacro) -->
  <arg name="base" default="kobuki"/>
  <arg name="stacks" default="hexagons"/>
  <arg name="3d_sensor" default="kinect"/>

  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_z" default="0.0"/>
  <arg name="spawn_yaw" default="0.0"/>

  <!-- Fonte do /scan:
         laser (padrão) = laser 2D simulado (240°, perfil Hokuyo) publicando /scan
                          direto do Gazebo. É a fonte primária/mais confiável.
         depth          = depthimage_to_laserscan (Kinect, FOV ~60°)
         cloud          = pointcloud_to_laserscan (Kinect, FOV ~60°)
       Em laser o robô carrega o URDF com laser (urdf_file abaixo); em depth/cloud
       carrega o robô padrão (sem laser) e o /scan vem do Kinect. -->
  <arg name="scan_source" default="laser"/>

  <!-- URDF com laser 2D (usado só quando scan_source:=laser). Espelha o default do
       kobuki.launch.xml, apenas trocando o robô por um que adiciona o laser. -->
  <arg name="laser_urdf_file"
       default="$(find xacro)/xacro '$(find robo_aspirador_kinect)/urdf/kobuki_hexagons_kinect_laser.urdf.xacro'"/>

  <!-- RViz persistente (mapa + scan + nuvem + robô + caminho de cobertura) -->
  <arg name="rviz" default="false"/>
  <arg name="rviz_config" default="$(find robo_aspirador_kinect)/config/navigation.rviz"/>

  <env name="TURTLEBOT_3D_SENSOR" value="$(arg 3d_sensor)"/>
  <env name="TURTLEBOT_BASE" value="$(arg base)"/>
  <env name="TURTLEBOT_STACKS" value="$(arg stacks)"/>
  <env name="ROBOT_INITIAL_POSE" value="-x $(arg spawn_x) -y $(arg spawn_y) -z $(arg spawn_z) -Y $(arg spawn_yaw)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- Cenário casa (reaproveitado do projeto robo_aspirador) -->
  <node name="spawn_casa" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
        args="-file $(find robo_aspirador_kinect)/worlds/casa/model.sdf -sdf -model casa -x 0 -y 0 -z 0"/>

  <!-- scan_source:=laser → robô COM laser 2D (urdf_file customizado) -->
  <include file="$(find turtlebot_gazebo)/launch/includes/$(arg base).launch.xml"
           if="$(eval scan_source == 'laser')">
    <arg name="base" value="$(arg base)"/>
    <arg name="stacks" value="$(arg stacks)"/>
    <arg name="3d_sensor" value="$(arg 3d_sensor)"/>
    <arg name="urdf_file" value="$(arg laser_urdf_file)"/>
  </include>

  <!-- scan_source:=depth|cloud → robô padrão (sem laser); /scan vem do Kinect -->
  <include file="$(find turtlebot_gazebo)/launch/includes/$(arg base).launch.xml"
           unless="$(eval scan_source == 'laser')">
    <arg name="base" value="$(arg base)"/>
    <arg name="stacks" value="$(arg stacks)"/>
    <arg name="3d_sensor" value="$(arg 3d_sensor)"/>
  </include>

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="30.0"/>
  </node>

  <!-- LaserScan derivado do Kinect (camada isolada; ver scan_source.launch) -->
  <include file="$(find robo_aspirador_kinect)/launch/scan_source.launch">
    <arg name="scan_source" value="$(arg scan_source)"/>
  </include>

  <!-- RViz (opcional): sobe junto do Gazebo para acompanhar mapeamento/cobertura -->
  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(arg rviz_config)" required="false" output="log"/>
</launch>
